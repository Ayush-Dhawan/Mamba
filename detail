<div class="container">

  <!-- HEADER -->
  <header>
    <div class="doc-badge">Technical Specification & Engineering Playbook</div>
    <h1 class="main-title">DS-BiCrossMamba: Multi-Scale Audio Deepfake Detection System</h1>
